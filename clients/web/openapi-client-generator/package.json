{
  "name": "@chimwemwe/ui1-openapi-client-generator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.15.0",
    "npm": "11.12.1"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "generate": "openapi-typescript ../../../apps/chimwemwe_core/priv/openapi/ui1-local-v1.json --output ../src/generated/ui1/schema.d.ts --alphabetize --immutable",
    "generate:public": "openapi-typescript ../../../apps/chimwemwe_core/priv/openapi/public-session-v1.json --output ../src/generated/public/session-schema.d.ts --alphabetize --immutable",
    "generate:check": "npm run generate:check:ui1 && npm run generate:check:public && npm run generate:check:staff && npm run generate:check:communications",
    "generate:check:public": "openapi-typescript ../../../apps/chimwemwe_core/priv/openapi/public-session-v1.json --output ../src/generated/public/session-schema.d.ts --alphabetize --immutable --check",
    "generate:check:ui1": "openapi-typescript ../../../apps/chimwemwe_core/priv/openapi/ui1-local-v1.json --output ../src/generated/ui1/schema.d.ts --alphabetize --immutable --check",
    "generate:staff": "openapi-typescript ../../../apps/chimwemwe_core/priv/openapi/staff-accounts-v1.json --output ../src/generated/public/staff-schema.d.ts --alphabetize --immutable",
    "generate:check:staff": "openapi-typescript ../../../apps/chimwemwe_core/priv/openapi/staff-accounts-v1.json --output ../src/generated/public/staff-schema.d.ts --alphabetize --immutable --check",
    "generate:communications": "openapi-typescript ../../../apps/chimwemwe_core/priv/openapi/communications-v1.json --output ../src/generated/public/communications-schema.d.ts --alphabetize --immutable",
    "generate:check:communications": "openapi-typescript ../../../apps/chimwemwe_core/priv/openapi/communications-v1.json --output ../src/generated/public/communications-schema.d.ts --alphabetize --immutable --check"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
