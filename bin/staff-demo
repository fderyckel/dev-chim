#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
# A new disposable database every run; previous synthetic evidence is retained.
export MIX_ENV=test CHIMWEMWE_STAFF_DEMO=true CHIMWEMWE_CLASSROOM_DEMO=true CHIMWEMWE_UI0_SYNTHETIC=true
CHIMWEMWE_TEST_DATABASE="chimwemwe_staff_demo_$(date +%s)_$$"
export CHIMWEMWE_TEST_DATABASE
cert_dir=$(mktemp -d /tmp/chimwemwe-staff-cert.XXXXXX)
backend_pid=""
web_pid=""
edge_pid=""
if [[ -n "${CHIMWEMWE_STAFF_CREDENTIAL_FILE:-}" ]] &&
  [[ -e "$CHIMWEMWE_STAFF_CREDENTIAL_FILE" || -L "$CHIMWEMWE_STAFF_CREDENTIAL_FILE" ]]; then
  echo "The private credential file must not already exist" >&2
  rmdir "$cert_dir"
  exit 1
fi
cleanup() {
  for process_id in "$edge_pid" "$web_pid" "$backend_pid"; do
    if [[ -n "$process_id" ]]; then kill "$process_id" 2>/dev/null || true; fi
  done
  if [[ -n "${CHIMWEMWE_STAFF_CREDENTIAL_FILE:-}" ]]; then
    rm -f -- "$CHIMWEMWE_STAFF_CREDENTIAL_FILE"
  fi
  rm -f "$cert_dir/key.pem" "$cert_dir/cert.pem" "$cert_dir/migration.log"
  rmdir "$cert_dir" 2>/dev/null || true
}
trap cleanup EXIT INT TERM
openssl req -x509 -newkey rsa:2048 -nodes -keyout "$cert_dir/key.pem" -out "$cert_dir/cert.pem" \
  -days 1 -subj /CN=localhost -addext subjectAltName=DNS:localhost >/dev/null 2>&1
mise exec -- mix ecto.create
if ! mise exec -- mix ecto.migrate > "$cert_dir/migration.log" 2>&1; then
  cat "$cert_dir/migration.log" >&2
  exit 1
fi
mise exec -- mix run tools/staff_demo.exs &
backend_pid=$!
(
  cd clients/web
  export CHIMWEMWE_WEB_BUILD_DIR=.next-staff
  exec mise exec -- node node_modules/next/dist/bin/next dev --hostname 127.0.0.1 --port 3016
) &
web_pid=$!
writer_ready=false
for _attempt in {1..90}; do
  if [[ "$(curl --silent --output /dev/null --write-out '%{http_code}' http://127.0.0.1:4015/api/v1/session || true)" == "401" ]]; then
    writer_ready=true
    break
  fi
  kill -0 "$backend_pid" 2>/dev/null || { echo "Staff writer did not start" >&2; exit 1; }
  kill -0 "$web_pid" 2>/dev/null || { echo "Staff browser app did not start" >&2; exit 1; }
  sleep 1
done
[[ "$writer_ready" == "true" ]] || { echo "Staff writer startup timed out" >&2; exit 1; }
mise exec -- node tools/staff_https.mjs "$cert_dir/key.pem" "$cert_dir/cert.pem" &
edge_pid=$!
printf 'Fictional database retained for review: %s\n' "$CHIMWEMWE_TEST_DATABASE"
wait "$backend_pid"
