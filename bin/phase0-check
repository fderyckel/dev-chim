#!/bin/sh
set -eu

repo_root=$(cd "$(dirname "$0")/.." && pwd -P)
spike_dir="$repo_root/spikes/ash-foundation-lab"
typescript_client_dir="$spike_dir/typescript-client-review"

cd "$repo_root"

if ! pg_isready >/dev/null 2>&1; then
  echo "PostgreSQL is not ready. Run: make bootstrap" >&2
  exit 1
fi

echo "[1/12] Python formatting"
mise exec -- uv run ruff format --check tools tests/tools

echo "[2/12] Python lint"
mise exec -- uv run ruff check tools tests/tools

echo "[3/12] Shell lint"
shellcheck .githooks/pre-push bin/bootstrap bin/phase0-check

echo "[4/12] Repository and documentation conventions"
mise exec -- uv run python tools/check_phase0.py

echo "[5/12] Python tests"
mise exec -- uv run pytest

echo "[6/12] Elixir formatting, generated migration drift, and lint"
(
  cd "$spike_dir"
  mise exec -- mix format --check-formatted
  mise exec -- mix ash_postgres.generate_migrations --check \
    --migration-path priv/generated_migration_review/migrations \
    --snapshot-path priv/generated_migration_review/resource_snapshots
  mise exec -- env MIX_ENV=test mix openapi.spec.json \
    --spec AshFoundationLab.JsonApiRouter \
    --check \
    --pretty=true \
    --filename priv/openapi/phase0-v1.json
  mise exec -- env MIX_ENV=test mix phase0.descriptor.check
  mise exec -- mix credo --strict
)

echo "[7/12] Generated TypeScript client contract"
(
  cd "$typescript_client_dir"
  mise exec -- npm run check
)

echo "[8/12] Ash dependency warning drift"
mise exec -- uv run python tools/check_ash_dependency_warnings.py

echo "[9/12] Dependency audits"
(
  cd "$spike_dir"
  mise exec -- mix hex.audit
  mise exec -- mix deps.unlock --check-unused
)
(
  cd "$typescript_client_dir"
  mise exec -- npm audit
)

echo "[10/12] Elixir type analysis"
(
  cd "$spike_dir"
  mise exec -- mix dialyzer
)

echo "[11/12] Elixir and PostgreSQL tests"
(
  cd "$spike_dir"
  mise exec -- env MIX_ENV=test mix test
)

echo "[12/12] Git whitespace check"
git diff --check

echo "Phase 0 local verification passed."
