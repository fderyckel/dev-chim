#!/bin/sh
set -eu

repo_root=$(cd "$(dirname "$0")/.." && pwd -P)
demo_database=${CHIMWEMWE_ORGANIZATION_LEGAL_DEMO_DATABASE:-chimwemwe_organization_legal_demo}

if ! command -v mise >/dev/null 2>&1; then
  echo "Missing required command: mise" >&2
  exit 1
fi

cd "$repo_root"

CHIMWEMWE_ORGANIZATION_LEGAL_DEMO_SETUP=true \
CHIMWEMWE_ORGANIZATION_LEGAL_DEMO_DATABASE="$demo_database" \
  mise exec -- mix ecto.create --quiet

CHIMWEMWE_ORGANIZATION_LEGAL_DEMO_SETUP=true \
CHIMWEMWE_ORGANIZATION_LEGAL_DEMO_DATABASE="$demo_database" \
  mise exec -- mix ecto.migrate --quiet

CHIMWEMWE_ORGANIZATION_LEGAL_DEMO=true \
CHIMWEMWE_ORGANIZATION_LEGAL_DEMO_DATABASE="$demo_database" \
  mise exec -- mix run -e 'Chimwemwe.OrganizationLegal.Demo.seed_and_print!()'
