{
  "components": {
    "schemas": {
      "ElevateSupportRequest": {
        "additionalProperties": false,
        "properties": {
          "grant_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "grant_id"
        ],
        "type": "object"
      },
      "ErrorItem": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "detail"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "errors": {
            "items": {
              "$ref": "#/components/schemas/ErrorItem"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "errors"
        ],
        "type": "object"
      },
      "SessionData": {
        "additionalProperties": false,
        "properties": {
          "actor_id": {
            "format": "uuid",
            "type": "string"
          },
          "assurance": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "csrf_token": {
            "description": "Same-origin proof required by unsafe session actions.",
            "maxLength": 200,
            "minLength": 20,
            "type": "string"
          },
          "idle_expires_at": {
            "format": "date-time",
            "type": "string"
          },
          "support": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SupportSession"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "actor_id",
          "assurance",
          "csrf_token",
          "idle_expires_at",
          "support"
        ],
        "type": "object"
      },
      "SessionResponse": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/SessionData"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "SupportSession": {
        "additionalProperties": false,
        "properties": {
          "capability_scope": {
            "items": {
              "maxLength": 120,
              "minLength": 3,
              "type": "string"
            },
            "maxItems": 8,
            "minItems": 1,
            "type": "array"
          },
          "expires_at": {
            "format": "date-time",
            "type": "string"
          },
          "mode": {
            "const": "support",
            "type": "string"
          },
          "purpose": {
            "maxLength": 240,
            "minLength": 3,
            "type": "string"
          },
          "support_actor_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "mode",
          "support_actor_id",
          "purpose",
          "expires_at",
          "capability_scope"
        ],
        "type": "object"
      },
      "SupportSessionResponse": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/SupportSession"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "applicationSession": {
        "in": "cookie",
        "name": "__Host-chimwemwe-session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Provider-neutral, same-origin application-session contract. Provider callbacks are not a client API.",
    "title": "Chimwemwe public session API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/session": {
      "get": {
        "operationId": "getCurrentSession",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            },
            "description": "Current application session",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store",
                  "type": "string"
                }
              },
              "X-API-Version": {
                "schema": {
                  "const": "v1",
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Session missing, expired, revoked, or stale",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store",
                  "type": "string"
                }
              },
              "X-API-Version": {
                "schema": {
                  "const": "v1",
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "applicationSession": []
          }
        ],
        "summary": "Read the current writer-validated application session"
      }
    },
    "/api/v1/session/logout": {
      "post": {
        "description": "Requires exact Origin and X-CSRF-Token headers.",
        "operationId": "logoutCurrentSession",
        "responses": {
          "204": {
            "description": "Authoritative session invalidated"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Session missing or no longer current",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store",
                  "type": "string"
                }
              },
              "X-API-Version": {
                "schema": {
                  "const": "v1",
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Origin or CSRF proof rejected",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store",
                  "type": "string"
                }
              },
              "X-API-Version": {
                "schema": {
                  "const": "v1",
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Writer temporarily unavailable",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store",
                  "type": "string"
                }
              },
              "X-API-Version": {
                "schema": {
                  "const": "v1",
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "applicationSession": []
          }
        ],
        "summary": "Log out the current exact session"
      }
    },
    "/api/v1/session/support/elevate": {
      "post": {
        "description": "Requires exact Origin and X-CSRF-Token headers.",
        "operationId": "elevateSupportSession",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ElevateSupportRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SupportSessionResponse"
                }
              }
            },
            "description": "Visible bounded support mode",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store",
                  "type": "string"
                }
              },
              "X-API-Version": {
                "schema": {
                  "const": "v1",
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid exact grant reference",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store",
                  "type": "string"
                }
              },
              "X-API-Version": {
                "schema": {
                  "const": "v1",
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Session missing or no longer current",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store",
                  "type": "string"
                }
              },
              "X-API-Version": {
                "schema": {
                  "const": "v1",
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Grant, origin, or CSRF proof rejected",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store",
                  "type": "string"
                }
              },
              "X-API-Version": {
                "schema": {
                  "const": "v1",
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Writer temporarily unavailable",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store",
                  "type": "string"
                }
              },
              "X-API-Version": {
                "schema": {
                  "const": "v1",
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "applicationSession": []
          }
        ],
        "summary": "Activate one pre-approved support grant"
      }
    }
  }
}