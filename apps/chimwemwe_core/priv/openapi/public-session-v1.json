                  "type": "string"
                }
              },
              "X-API-Version": {
                "schema": {
                  "const": "v1",
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "applicationSession": []
          }
        ],
        "summary": "Log out the current exact session"
      }
    },
