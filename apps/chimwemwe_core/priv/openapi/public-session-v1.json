{
  "components": {
    "schemas": {
      "AssignedClassesResponse": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "id": {
                  "format": "uuid",
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "local_date": {
                  "format": "date",
                  "type": "string"
                }
              },
              "required": [
                "id",
                "label",
                "local_date"
              ],
              "type": "object"
            },
            "maxItems": 12,
            "type": "array"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "AttendanceReceiptResponse": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "additionalProperties": false,
            "properties": {
              "submission_id": {
                "format": "uuid",
                "type": "string"
              }
            },
            "required": [
              "submission_id"
            ],
            "type": "object"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "AttendanceResponse": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/AttendanceView"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "AttendanceView": {
        "additionalProperties": false,
        "properties": {
          "calendar_revision": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "class_id": {
            "format": "uuid",
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "local_date": {
            "format": "date",
            "type": "string"
          },
          "roster_basis": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "students": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "id": {
                  "format": "uuid",
                  "type": "string"
                },
                "mark": {
                  "anyOf": [
                    {
                      "enum": [
                        "present",
                        "absent",
                        "late"
                      ],
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "mark",
                "name"
              ],
              "type": "object"
            },
            "maxItems": 60,
            "type": "array"
          },
          "submission_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "calendar_revision",
          "class_id",
          "label",
          "local_date",
          "roster_basis",
          "students",
          "submission_id"
        ],
        "type": "object"
      },
      "ElevateSupportRequest": {
        "additionalProperties": false,
        "properties": {
          "grant_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "grant_id"
        ],
        "type": "object"
      },
      "ErrorItem": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "detail"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "errors": {
            "items": {
              "$ref": "#/components/schemas/ErrorItem"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "errors"
        ],
        "type": "object"
      },
      "PrepareAttendanceRequest": {
        "additionalProperties": false,
        "properties": {
          "class_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "class_id"
        ],
        "type": "object"
      },
      "SessionData": {
        "additionalProperties": false,
        "properties": {
          "actor_id": {
            "format": "uuid",
            "type": "string"
          },
          "assurance": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "csrf_token": {
            "description": "Same-origin proof required by unsafe session actions.",
            "maxLength": 200,
            "minLength": 20,
            "type": "string"
          },
          "idle_expires_at": {
            "format": "date-time",
            "type": "string"
          },
          "support": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SupportSession"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "actor_id",
          "assurance",
          "csrf_token",
          "idle_expires_at",
          "support"
        ],
        "type": "object"
      },
      "SessionResponse": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/SessionData"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "SubmitAttendanceRequest": {
        "additionalProperties": false,
        "properties": {
          "calendar_revision": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "causation_id": {
            "format": "uuid",
            "type": "string"
          },
          "class_id": {
            "format": "uuid",
            "type": "string"
          },
          "idempotency_key": {
            "format": "uuid",
            "type": "string"
          },
          "local_date": {
            "format": "date",
            "type": "string"
          },
          "marks": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "mark": {
                  "enum": [
                    "present",
                    "absent",
                    "late"
                  ],
                  "type": "string"
                },
                "person_id": {
                  "format": "uuid",
                  "type": "string"
                }
              },
              "required": [
                "mark",
                "person_id"
              ],
              "type": "object"
            },
            "maxItems": 60,
            "minItems": 1,
            "type": "array"
          },
          "roster_basis": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "calendar_revision",
          "causation_id",
          "class_id",
          "idempotency_key",
          "local_date",
          "marks",
          "roster_basis"
        ],
        "type": "object"
      },
      "SupportSession": {
        "additionalProperties": false,
        "properties": {
          "capability_scope": {
            "items": {
              "maxLength": 120,
              "minLength": 3,
              "type": "string"
            },
            "maxItems": 8,
            "minItems": 1,
            "type": "array"
          },
          "expires_at": {
            "format": "date-time",
            "type": "string"
          },
          "mode": {
            "const": "support",
            "type": "string"
          },
          "purpose": {
            "maxLength": 240,
            "minLength": 3,
            "type": "string"
          },
          "support_actor_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "mode",
          "support_actor_id",
          "purpose",
          "expires_at",
          "capability_scope"
        ],
        "type": "object"
      },
      "SupportSessionResponse": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/SupportSession"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "applicationSession": {
        "in": "cookie",
        "name": "__Host-chimwemwe-session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Provider-neutral, same-origin application-session contract. Provider callbacks are not a client API.",
