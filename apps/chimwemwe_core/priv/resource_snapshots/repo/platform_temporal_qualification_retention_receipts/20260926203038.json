  "custom_statements": [
    {
      "after_tables": [
        "platform_temporal_qualification_retention_receipts"
      ],
      "code?": false,
      "down": "DROP FUNCTION guard_platform_temporal_retention_receipt();",
      "global?": true,
      "name": "platform_temporal_retention_receipt_guard_function",
      "up": "CREATE FUNCTION guard_platform_temporal_retention_receipt()\nRETURNS trigger LANGUAGE plpgsql AS $$\nBEGIN\n  IF TG_OP IN ('UPDATE', 'DELETE') THEN\n    RAISE EXCEPTION USING ERRCODE = '23514',\n      CONSTRAINT = 'platform_temporal_retention_receipt_immutable',\n      MESSAGE = 'temporal retention receipts are immutable';\n  END IF;\n  NEW.recorded_at := transaction_timestamp() AT TIME ZONE 'UTC';\n  RETURN NEW;\nEND;\n$$;\n"
    },
    {
      "after_tables": [
        "platform_temporal_qualification_retention_receipts"
      ],
      "code?": false,
      "down": "DROP TRIGGER platform_temporal_retention_receipt_guard ON platform_temporal_qualification_retention_receipts;",
      "global?": true,
      "name": "platform_temporal_retention_receipt_guard_trigger",
      "up": "CREATE TRIGGER platform_temporal_retention_receipt_guard\nBEFORE INSERT OR UPDATE OR DELETE ON platform_temporal_qualification_retention_receipts\nFOR EACH ROW EXECUTE FUNCTION guard_platform_temporal_retention_receipt();\n"
    }
  ],
