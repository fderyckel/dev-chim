      "attribute": [
        "module_version"
      ],
      "base_filter": null,
      "check": "char_length(module_version) BETWEEN 5 AND 80 AND module_version ~ '^[0-9]+\\.[0-9]+\\.[0-9]+([+-][0-9A-Za-z.-]+)?$'",
      "name": "platform_module_activation_version_must_be_valid"
    },
    {
