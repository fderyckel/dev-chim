      "check": "state IN ('active', 'inactive')",
      "name": "platform_module_activation_state_must_be_known"
    },
    {
      "attribute": [
        "lock_version"
      ],
      "base_filter": null,
      "check": "lock_version >= 1",
      "name": "platform_module_activation_lock_version_must_be_positive"
    },
    {
      "attribute": [
        "consumer_cursor",
        "replay_from_cursor",
        "last_reconciled_cursor"
      ],
      "base_filter": null,
      "check": "consumer_cursor >= 0 AND\n  (replay_from_cursor IS NULL OR replay_from_cursor >= 0) AND\n  last_reconciled_cursor >= 0\n",
      "name": "platform_module_activation_cursors_must_be_nonnegative"
    },
    {
      "attribute": [
        "projection_version"
      ],
      "base_filter": null,
      "check": "projection_version >= 1",
      "name": "platform_module_activation_projection_version_must_be_positive"
    },
    {
      "attribute": [
        "retained_data_state"
      ],
      "base_filter": null,
      "check": "retained_data_state = 'retained'",
      "name": "platform_module_activation_retained_data_must_remain_owned"
    },
    {
      "attribute": [
        "state",
        "replay_from_cursor",
        "projection_ready",
        "reconciliation_required",
        "deactivated_at"
      ],
      "base_filter": null,
      "check": "(state = 'active' AND replay_from_cursor IS NULL AND projection_ready = true AND\n  reconciliation_required = false) OR\n(state = 'inactive' AND replay_from_cursor IS NOT NULL AND projection_ready = false AND\n  reconciliation_required = true AND deactivated_at IS NOT NULL)\n",
      "name": "platform_module_activation_state_must_be_consistent"
    }
  ],
