      "attribute": [
        "relationship_type"
      ],
      "base_filter": null,
      "check": "relationship_type IN (\n  'equity_interest',\n  'governing_body_appointment',\n  'statutory_control',\n  'contractual_control'\n)\n",
      "name": "organization_legal_relationships_type_allowed"
    },
    {
      "attribute": [
        "relationship_type",
        "interest_bps"
      ],
      "base_filter": null,
      "check": "(relationship_type = 'equity_interest' AND interest_bps BETWEEN 1 AND 10000) OR\n(relationship_type <> 'equity_interest' AND interest_bps IS NULL)\n",
      "name": "organization_legal_relationships_interest_consistent"
    },
    {
      "attribute": [
        "relationship_type",
        "basis_key"
      ],
      "base_filter": null,
      "check": "(relationship_type = 'equity_interest' AND basis_key = 'registered_equity') OR\n(relationship_type = 'governing_body_appointment' AND basis_key = 'governing_instrument') OR\n(relationship_type = 'statutory_control' AND basis_key = 'statute') OR\n(relationship_type = 'contractual_control' AND basis_key = 'contract')\n",
      "name": "organization_legal_relationships_basis_consistent"
    },
    {
      "attribute": [
        "source_legal_entity_id",
        "target_legal_entity_id"
      ],
